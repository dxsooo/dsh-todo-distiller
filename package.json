{
  "name": "dsh-todo-distiller",
  "version": "0.1.0",
  "description": "dsh-todo-distiller — a DeepSeek Harness plugin (tool template).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./reminders": "./dist/reminders.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/",
    "dev:patch": "node scripts/make-dev-patch.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-error": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-error": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "todo",
    "reminders"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  }
}
